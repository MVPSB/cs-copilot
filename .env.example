# 复制为 .env 后填写；.env 已被 .gitignore 忽略，切勿提交。

# Dify 应用 API（Dify 工作室 → 应用 → 访问 API）
DIFY_BASE_URL=http://localhost/v1
DIFY_APP_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# 网关（web/）
# 生产环境务必换成随机长串：python -c "import secrets;print(secrets.token_urlsafe(32))"
WEB_SECRET=change-me-in-env
WEB_HOST=127.0.0.1
WEB_PORT=8100
# WEB_DB=web/data/workbench.db
